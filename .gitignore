# 默认忽略 ~/.codex 中的运行时状态，只白名单纳入静态配置与仓库说明
/*

# 仓库元数据与说明
!/.gitignore
!/README.md
!/reports/

# Codex 静态配置本体
!/AGENTS.md
!/config.toml
!/hooks.json
!/agents/
!/skills/

# 白名单目录内的备份、缓存与可再生依赖
*.bak*
.DS_Store
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.pyo
agents/*.backup

# 含合成私钥头的安全扫描测试夹具不是运行所需配置，精确排除
skills/gstack/test/brain-sync.test.ts
skills/gstack/test/gstack-decision-bins.test.ts
skills/gstack/test/gstack-decision.test.ts
skills/gstack/test/redact-engine.test.ts
